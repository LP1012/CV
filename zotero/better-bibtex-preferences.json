      "platform": "mac",
      "postscript": "if (Translator.BetterTeX) {\n  // --- 1. Category from the subcollection the item is filed in ---\n  var categoryNames = ['ConfPapers', 'TechReports', 'Journals', 'Books', 'Software'];\n  if (zotero.collections && zotero.collections.length) {\n    var found = [];\n    zotero.collections.forEach(function(key) {\n      var coll = Translator.collections[key];\n      if (coll && categoryNames.indexOf(coll.name) !== -1) {\n        found.push(coll.name);\n      }\n    });\n    if (found.length > 0) {\n      tex.add({ name: 'keywords', value: found.join(',') });\n    }\n  }\n\n  // --- 2. Find your name in the author list and highlight it ---\n  var creators = zotero.creators || [];\n  var myIndex = -1;\n  for (var i = 0; i < creators.length; i++) {\n    var c = creators[i];\n    if (c.creatorType !== 'author') continue;\n    var last = (c.lastName || '').toLowerCase();\n    var first = (c.firstName || '').toLowerCase();\n    if (last === 'pohlmann') {\n      myIndex = i + 1;\n      break;\n    }\n  }\n  if (myIndex > 0) {\n    tex.add({ name: 'author+an', value: myIndex + '=highlight;' });\n  }\n}",
